# ---------------------------------------------------------------------------
# AI Running Coach — environment configuration
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Garmin Connect (optional) ---------------------------------------------
# Credentials for the unofficial python-garminconnect library.
# Leave empty to run in DEMO mode (uses bundled sample data, no login needed).
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Directory where the Garmin auth tokens are cached (so you don't log in every run).
GARMIN_TOKEN_STORE=.garmin_tokens

# --- Strava (optional, event-driven sync via OAuth + webhooks) -------------
# Create an API application at https://www.strava.com/settings/api to get the
# client id/secret. Strava then PUSHES a webhook on every new activity, so we
# don't poll. Leave empty to disable Strava (Garmin/demo keep working).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Public HTTPS base URL of this deployment (no trailing slash). Used to build
# the OAuth redirect (/api/strava/callback) and webhook callback
# (/api/strava/webhook). Example: https://my-coach.fly.dev
STRAVA_PUBLIC_BASE_URL=
# Arbitrary secret echoed during the webhook subscription handshake.
STRAVA_WEBHOOK_VERIFY_TOKEN=running-coach

# --- Yazio (optional, diario alimentare) ------------------------------------
# Unofficial API with no OAuth consent screen: the credentials pass through the
# app. They are read ONCE by `python -m app.cli nutrition --connect`, exchanged
# for tokens (stored encrypted) and never persisted. Setting them here — rather
# than typing them on the command line — keeps the password out of `ps` and the
# shell history. Leave empty to disable: the coach simply says nothing about
# fuelling.
YAZIO_USERNAME=
YAZIO_PASSWORD=
# The app-level client pair Yazio's own mobile client presents. NOT your
# personal credentials: it identifies the *application*, and every copy of the
# Yazio app carries the same one. Yazio versions it, and a stale pair is refused
# with "Invalid client" before your password is even read — which is why it
# lives here rather than hardcoded: a rotation becomes a secret update.
YAZIO_CLIENT_ID=
YAZIO_CLIENT_SECRET=

# --- Anthropic / Claude (optional) -----------------------------------------
# API key from https://console.anthropic.com  (billed separately, pay-as-you-go).
# Leave empty to run in OFFLINE coaching mode (rule-based fallback, no AI cost).
ANTHROPIC_API_KEY=
# Model used for single-run + weekly coaching.
COACH_MODEL=claude-sonnet-4-6
# Model used for deeper weekly planning (optional, defaults to COACH_MODEL).
PLANNER_MODEL=claude-opus-4-8

# --- Application ------------------------------------------------------------
# Runtime environment: development | production | test
APP_ENV=development
# Logging
LOG_LEVEL=INFO
LOG_JSON=false
# SQLite database location.
DATABASE_URL=sqlite:///data/running_coach.db
# How many recent activities to pull from Garmin per ingest.
FETCH_LIMIT=10
# Athlete profile used to tailor coaching (free text, optional).
ATHLETE_PROFILE=Runner amatoriale, 4-5 uscite a settimana.
# Max age (days) considered "recent" for rolling context.
ROLLING_WINDOW_DAYS=14

# --- Resilience -------------------------------------------------------------
# Retries/timeouts for the external integrations.
GARMIN_MAX_RETRIES=3
GARMIN_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_TIMEOUT_SECONDS=60
# If the Claude call fails, fall back to the offline rule-based coach.
AI_FALLBACK_OFFLINE=true

# --- Security (recommended when exposing the dashboard publicly) ------------
# When set, the dashboard and API require this bearer token (or ?token=).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
API_TOKEN=
# Comma-separated allowed CORS origins ("*" for all). Empty disables CORS.
CORS_ORIGINS=

# --- MCP server / Claude custom connector ----------------------------------
# See docs/MCP_CONNECTOR_ROADMAP.md. Left empty the MCP endpoint does not
# exist at all (every path 404s) — this is the safe default.
#
# Set it to publish the server at /mcp-<token>. The path IS the credential:
# claude.ai cannot send an Authorization header to a non-OAuth connector, so
# the URL is the secret. Use a long random value and treat it like a password:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_PATH_TOKEN=
# Public hostname(s) the connector is reached through, comma-separated
# (e.g. ai-running-coach.fly.dev). Enables the SDK's DNS-rebinding protection;
# leave empty to skip the Host check (the endpoint would otherwise reject
# every non-localhost request with 421).
MCP_ALLOWED_HOSTS=
# Local development only: serve an unauthenticated /mcp so the MCP Inspector
# and Claude Code can connect to localhost. Ignored when APP_ENV=production.
MCP_DEV_UNPROTECTED=false

# --- Raw activity archive (Tigris / S3-compatible) -------------------------
# When configured, every Garmin activity (running and non-running) is archived
# as raw payloads (summary JSON, second-by-second streams, splits, weather,
# gear, GPX, FIT/ORIGINAL, TCX). Leave empty to disable.
#
# On Fly.io with Tigris ("fly storage create my-bucket --org <org>"), the
# platform injects AWS_ENDPOINT_URL_S3, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_REGION and BUCKET_NAME as secrets, which are picked up automatically.
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_KEY_PREFIX=garmin
RAW_ARCHIVE_ENABLED=true

# --- Backups (optional, for hosts without a persistent disk) ----------------
# See docs/DEPLOYMENT.md for the Litestream + Cloudflare R2 setup.
BACKUP_ENABLED=false
LITESTREAM_REPLICA_URL=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
