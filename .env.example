# ---------------------------------------------------------------------------
# AI Running Coach — environment configuration
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Garmin Connect (optional) ---------------------------------------------
# Credentials for the unofficial python-garminconnect library.
# Leave empty to run in DEMO mode (uses bundled sample data, no login needed).
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Directory where the Garmin auth tokens are cached (so you don't log in every run).
GARMIN_TOKEN_STORE=.garmin_tokens

# --- Anthropic / Claude (optional) -----------------------------------------
# API key from https://console.anthropic.com  (billed separately, pay-as-you-go).
# Leave empty to run in OFFLINE coaching mode (rule-based fallback, no AI cost).
ANTHROPIC_API_KEY=
# Model used for single-run + weekly coaching.
COACH_MODEL=claude-sonnet-4-6
# Model used for deeper weekly planning (optional, defaults to COACH_MODEL).
PLANNER_MODEL=claude-opus-4-8

# --- Application ------------------------------------------------------------
# SQLite database location.
DATABASE_URL=sqlite:///data/running_coach.db
# How many recent activities to pull from Garmin per ingest.
FETCH_LIMIT=10
# Athlete profile used to tailor coaching (free text, optional).
ATHLETE_PROFILE=Runner amatoriale, 4-5 uscite a settimana.
# Max age (days) considered "recent" for rolling context.
ROLLING_WINDOW_DAYS=14
